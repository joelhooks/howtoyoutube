{
  "name": "howtoyoutube",
  "version": "0.1.0",
  "private": true,
  "description": "The YouTube playbook for technical creators, at howtoyoutube.dev.",
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite dev",
    "deploy": "./scripts/deploy.sh",
    "migrate": "node scripts/migrate-html.mjs",
    "verify": "node scripts/verify.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "check": "pnpm run build && pnpm run verify && pnpm run typecheck && oxfmt --check .",
    "format": "oxfmt ."
  },
  "dependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.84",
    "@effect/platform-bun": "4.0.6",
    "@effect/platform-node": "4.0.6",
    "@effect/platform-node-shared": "4.0.6",
    "alchemy": "2.0.0-beta.84",
    "effect": "4.0.6",
    "foldkit": "0.169.0"
  },
  "devDependencies": {
    "@foldkit/vite-plugin": "0.28.0",
    "@types/node": "24.19.2",
    "htmlparser2": "12.0.0",
    "oxfmt": "0.73.0",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.3.0",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.0.0",
      "onFail": "warn"
    }
  }
}
