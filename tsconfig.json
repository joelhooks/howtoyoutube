{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "checkJs": false,
    "esModuleInterop": true,
    "exactOptionalPropertyTypes": true,
    "lib": [
      "ESNext"
    ],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "noEmit": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "types": [
      "node"
    ]
  },
  "include": [
    "alchemy.run.ts"
  ]
}
